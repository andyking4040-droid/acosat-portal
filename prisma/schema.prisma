generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// Keep all the models (User, Course, Enrollment, Grade)

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   // "student" | "lecturer" | "admin"
  createdAt DateTime @default(now())

  // Existing relations
  enrollments Enrollment[]
  grades      Grade[]      @relation("StudentGrades")
  courses     Course[]     @relation("LecturerCourses")

  // NEW relations (add these two lines)
  submissions  Submission[]
  quizAttempts QuizAttempt[]
  certificates Certificate[]
  lessonProgress LessonProgress[]
  notifications Notification[]
  forumPosts   ForumPost[]
  forumReplies ForumReply[]
  forumPostReads ForumPostRead[]
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  credits     Int
  department  String   @default("Computer Science")
  status      String   @default("open")
  lecturerId  String?
  lecturer    User?    @relation("LecturerCourses", fields: [lecturerId], references: [id])
  createdAt   DateTime @default(now())

  // Existing relations
  enrollments Enrollment[]
  grades      Grade[]

  // NEW relation (add this line)
  modules Module[]
  certificates Certificate[]
  liveSessions LiveSession[]
  forumPosts ForumPost[]

}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  status     String   @default("active") // active | completed | dropped
  enrolledAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  assessment  String
  score       Float?
  letterGrade String?
  comments    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User   @relation("StudentGrades", fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(1)
  courseId    String
  createdAt   DateTime @default(now())

  // Add these two new fields:
  slidesUrl   String?
  slidesTitle String?

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  content     String?  // Can store HTML or Markdown
  videoUrl    String?
  order       Int      @default(0)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  progress LessonProgress[]
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  maxScore    Int      @default(100)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  content      String?  // Student answer or file link
  score        Float?
  feedback     String?
  submittedAt  DateTime @default(now())
  studentId    String
  assignmentId String

  student    User       @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  timeLimit   Int?     // in minutes
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  text          String
  type          String   @default("multiple_choice") // multiple_choice | true_false | short_answer
  points        Int      @default(1)
  order         Int      @default(0)
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options       Option[]
  answers QuizAnswer[]
}

model Option {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  score       Float?
  maxScore    Float?
  completedAt DateTime?
  startedAt   DateTime @default(now())
  studentId   String
  quizId      String

  student User @relation(fields: [studentId], references: [id])
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]
}

model QuizAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  selectedOptionId String?   // for multiple choice
  textAnswer  String?        // for short answer
  isCorrect   Boolean?
  pointsAwarded Float?
  createdAt   DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

}

model Certificate {
  id          String   @id @default(cuid())
  title       String
  fileUrl     String?          // URL or path to the PDF
  issuedAt    DateTime @default(now())
  studentId   String
  courseId    String

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  description String?
  meetingUrl  String
  scheduledAt DateTime
  duration    Int?     // in minutes
  courseId    String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
model LibraryResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String   @default("General")
  createdAt   DateTime @default(now())
}

model LessonProgress {
  id          String   @id @default(cuid())
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())
  studentId   String
  lessonId    String

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  courseId  String

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  replies ForumReply[]
  reads ForumPostRead[]
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  authorId  String
  postId    String

  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ForumPostRead {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  readAt    DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}
